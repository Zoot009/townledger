# Public origin, no trailing slash: canonical URLs, sitemap, structured data, and the domain stamped on listing requests.
SITE_URL=https://www.townledger.com

# Read-only database login (SELECT on the directory tables). Port 5432 = Supabase session pooler.
WEB_DATABASE_URL=

# Insert-only login for the "Add a business" form (INSERT on listing_requests).
WEB_FORMS_DATABASE_URL=
